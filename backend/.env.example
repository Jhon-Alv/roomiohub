# Copia este archivo como .env dentro de la carpeta 'backend/' y reemplaza los valores.

# Configuracion de PostgreSQL (Docker / Local)
POSTGRES_DB=roomiohub_db
POSTGRES_USER=tu_usuario
POSTGRES_PASSWORD=tu_password_seguro
POSTGRES_PORT=5432

# Spring Boot — Datasource
BD_ROOMIOHUB_URL=jdbc:postgresql://localhost:5432/roomiohub_db?timezone=America/Lima
BD_ROOMIOHUB_USERNAME=tu_usuario
BD_ROOMIOHUB_PASSWORD=tu_password_seguro


# Seguridad JWT
JWT_SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_BASE64_SEGURA

# URL base de la landing page (para back_urls de MercadoPago)
LANDING_BASE_URL=http://localhost:4321

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000000-000000000000000-0000000000
MERCADOPAGO_PUBLIC_KEY=TEST-0000000000000000000-000000000000000-0000000000
MERCADOPAGO_WEBHOOK_SECRET=

# CORS (origines permitidos separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4321
