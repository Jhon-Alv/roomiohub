# ============================================================
# Caddyfile — RoomioHub
# ============================================================

http:// {
    handle /api/* {
        reverse_proxy localhost:8080 {
            transport http {
                read_timeout 30s
                write_timeout 30s
            }
        }
    }

    handle /app/* {
        uri strip_prefix /app
        root * /opt/app/frontend/dist
        encode gzip zstd
        try_files {path} /index.html
        file_server
    }

    handle {
        root * /opt/app/landing
        encode gzip zstd
        try_files {path} /index.html
        file_server
    }
}
