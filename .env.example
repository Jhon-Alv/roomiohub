# ==========================================
# RoomioHub — Variables de Entorno
# ==========================================
# Copia este archivo como .env y reemplaza los valores.
# NUNCA subas el archivo .env al repositorio.

# PostgreSQL
POSTGRES_DB=roomiohub_db
POSTGRES_USER=tu_usuario
POSTGRES_PASSWORD=tu_password_seguro
POSTGRES_PORT=5432

# Spring Boot — Datasource
BD_ROOMIOHUB_URL=jdbc:postgresql://localhost:5432/roomiohub_db?timezone=America/Lima
BD_ROOMIOHUB_USERNAME=tu_usuario
BD_ROOMIOHUB_PASSWORD=tu_password_seguro

# JWT (genera una clave segura en Base64 de al menos 256 bits)
JWT_SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_BASE64_SEGURA
